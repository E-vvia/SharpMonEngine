<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpMonEngine.Battle\SharpMonEngine.Battle.csproj"/>
        <ProjectReference Include="..\SharpMonEngine.Impl\SharpMonEngine.Impl.csproj"/>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../BuildTools/Symlink.cs&quot; -- &quot;$(TargetPath)&quot; &quot;$(MSBuildProjectDirectory)/../SharpMonEngine.Unity/Assets/SharpMonEngine/$(MSBuildProjectName)/$(MSBuildProjectName).dll&quot;&#xA;&#xA;dotnet run --file &quot;$(MSBuildProjectDirectory)/../BuildTools/Symlink.cs&quot; -- &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(MSBuildProjectDirectory)/../SharpMonEngine.Unity/Assets/SharpMonEngine/$(MSBuildProjectName)/$(MSBuildProjectName).pdb&quot;"/>
    </Target>

</Project>
