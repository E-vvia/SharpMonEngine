<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DefineConstants>TRACE; UNITY_EDITOR</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Assets\**"/>
        <None Remove="Library\**"/>
        <None Remove="Logs\**"/>
        <None Remove="Packages\**"/>
        <None Remove="ProjectSettings\**"/>
        <None Remove="Temp\**"/>
        <None Remove="UserSettings\**"/>
        <None Remove=".gitignore"/>
        <None Remove="mono_crash.mem.21101.1.blob"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Assets\**"/>
        <Compile Remove="Library\**"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="Assets\**"/>
        <EmbeddedResource Remove="Library\**"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpMonEngine.Core\SharpMonEngine.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Exceptions\Controllers\"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Unity.InputSystem">
            <HintPath>Library\ScriptAssemblies\Unity.InputSystem.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>..\ExternalLibs\UnityEngine.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../BuildTools/Symlink.cs&quot; -- &quot;$(TargetPath)&quot; &quot;$(MSBuildProjectDirectory)/../SharpMonEngine.Unity/Assets/SharpMonEngine/$(MSBuildProjectName)/$(MSBuildProjectName).dll&quot;&#xA;&#xA;dotnet run --file &quot;$(MSBuildProjectDirectory)/../BuildTools/Symlink.cs&quot; -- &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(MSBuildProjectDirectory)/../SharpMonEngine.Unity/Assets/SharpMonEngine/$(MSBuildProjectName)/$(MSBuildProjectName).pdb&quot;"/>
    </Target>

</Project>
